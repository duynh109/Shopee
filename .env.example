# Biến cho docker compose (docker-compose.yml). Chép thành .env rồi điền; .env đã có trong .gitignore.
# Chạy BE trực tiếp bằng ./mvnw thì dùng BE/.env, không phải file này.

# Mật khẩu MySQL trong container, đặt gì cũng được — chỉ dùng cho DB của Docker.
DB_PASSWORD=
# Khoá ký JWT, càng dài càng tốt (88 kí tự → HS512). Tạo bằng:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
