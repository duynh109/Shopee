# Secret cho BE, không commit. Dùng cho cả ./mvnw spring-boot:run (đọc từ thư mục BE/) và
# docker compose --env-file BE/.env (khi đó DB_PASSWORD là mật khẩu MySQL trong container, đặt gì cũng được).
DB_PASSWORD=
# Khoá ký JWT, càng dài càng tốt (88 kí tự → HS512). Tạo bằng:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=
